# Copie para backend/.env somente se precisar alterar os padrões locais.
MYSQL_HOST=127.0.0.1
MYSQL_PORTA=3306
MYSQL_USUARIO=soma
MYSQL_SENHA=soma_local_123
MYSQL_BANCO=soma
# Supabase / PostgreSQL: descomente para substituir o MySQL.
# Consulte docs/SUPABASE.md. Nunca use estas variáveis no Expo.
# BANCO_TIPO=postgres
# DATABASE_URL=postgresql://postgres.REFERENCIA:SENHA_CODIFICADA@HOST_POOLER:5432/postgres
# PGSSLROOTCERT=C:/certificados/prod-ca.crt
PORTA=3001
ENDERECO=127.0.0.1
# Opcional: origem exata de um front servido em outra porta/endereço.
# ORIGEM_WEB=http://127.0.0.1:3002
# Em HTTPS atrás de proxy, habilite o atributo Secure do cookie de sessão.
# COOKIE_SEGURO=1
# EXPO_PUBLIC_URL_BACKEND é configuração pública do Expo, nunca inclua senhas nela.

# Google OAuth web é opcional. Configure no Google Cloud antes de preencher.
# Nunca coloque o client secret em EXPO_PUBLIC_ ou no aplicativo.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# URI sugerida no desenvolvimento: http://localhost:3001/api/auth/google/callback
