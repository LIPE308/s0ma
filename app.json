{
  "expo": {
    "name": "SOMA",
    "slug": "soma-pulso",
    "version": "1.1.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/90068c5e-1b11-40f7-b9ee-2b0bb8d6061d",
      "enabled": true,
      "checkAutomatically": "ON_ERROR_RECOVERY",
      "fallbackToCacheTimeout": 0,
      "useEmbeddedUpdate": true,
      "disableAntiBrickingMeasures": false
    },
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "soma",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.soma.pulso",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1748F5",
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.soma.pulso",
      "versionCode": 3
    },
    "web": {
      "output": "single",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#1748F5",
          "dark": {
            "backgroundColor": "#1748F5"
          }
        }
      ],
      "expo-asset",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Escolha uma imagem para sua campanha ou seu perfil no Soma.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      "expo-video",
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "90068c5e-1b11-40f7-b9ee-2b0bb8d6061d"
      }
    },
    "owner": "studio308"
  }
}
