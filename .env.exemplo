# Variáveis de ambiente da API (Expo requer o prefixo EXPO_PUBLIC_ para leitura no app)
EXPO_PUBLIC_API_URL=https://senac.pizzarapida.net/api
EXPO_PUBLIC_API_TOKEN=SOLICITAR_TOKEN_AO_GESTOR_DA_EQUIPE

# API do SOMA: use HTTPS público para um APK independente.
# EXPO_PUBLIC_URL_BACKEND=https://seu-servidor/api

# Backend local do SOMA. Guardar senhas reais somente em backend/.env.
# BANCO_TIPO=mysql
# MYSQL_HOST=127.0.0.1
# MYSQL_PORTA=3307
# MYSQL_USUARIO=soma
# MYSQL_BANCO=soma
