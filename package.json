{
  "name": "flatList",
  "main": "expo-router/entry",
  "version": "1.0.1",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "servidor": "node backend/servidor.js",
    "servidor:rede-local": "node scripts/servidor-rede-local.js",
    "admin:configurar": "node backend/configurar-admin.js",
    "banco:iniciar": "docker compose up -d --wait banco",
    "banco:local": "node backend/mysql-local.js iniciar",
    "banco:local:estado": "node backend/mysql-local.js estado",
    "banco:local:parar": "node backend/mysql-local.js parar",
    "testar:backend:local": "node backend/mysql-local.js testar",
    "compilar:web": "expo export --platform web --max-workers 2",
    "testar:backend": "node --test backend/regras-soma2.test.js backend/testes.test.js backend/testes-soma2.test.js backend/compatibilidade.test.js",
    "testar:inteligencia": "node --test backend/inteligencia.test.js",
    "testar:experiencia": "node --experimental-strip-types --test backend/experiencia.test.js",
    "verificar:tipos": "tsc --noEmit",
    "testar:mapa": "node --experimental-strip-types --test backend/mapa.test.js backend/camera-mapa.test.js",
    "testar:postgres": "node --test backend/postgres.test.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
